# ==========================================
# Backend Environment Variables Example
# ==========================================

# 1. Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-share-this

# 2. AI & Model Providers
# Groq (Used for LLM and Audio Transcription)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter (Used for Image/Vision Analysis)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# HuggingFace (Used for downloading the embedding model)
# Get your key at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# 3. Model Configuration (Optional Defaults)
LLM_MODEL=openai/gpt-oss-120b
VISION_MODEL=llama-4-maverick
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
WHISPER_MODEL=whisper-large-v3-turbo

# 4. App Configuration
# The directory where temporary files are stored during processing
TEMP_UPLOAD_DIR=/tmp/multimodal_rag_uploads
